# ── Mission Deck - configuration ─────────────────────────────────────────────
# API tokens come from Bitwarden (Settings -> Keys -> Unlock).
# .env holds CONFIGURATION ONLY - never a secret.

# Server port (default 3001).
PORT=3001

# Directory for user content (gitignored): plans, exports, history.
USER_DATA_DIR=./user-data

# ── Bitwarden ────────────────────────────────────────────────────────────────
# Name of the Bitwarden collection the app reads its tokens from.
#
# This file deliberately names NO token variable. Tokens do not belong in .env:
# they live in Bitwarden and, once the vault is unlocked, only in the memory of
# the server process. A variable name listed here would be an invitation to
# paste a value next to it, and the server would not read it anyway. The list
# of expected vault items (item name -> what it is for) is in README.md and
# docs/guides/ONBOARDING.md.
#
# The three PROJECT tokens (COCKPIT-APP, COCKPIT-DATA, COCKPIT-MODULES) are
# created from Settings -> Keys; that needs only a GITLAB-PERSONAL item. Your
# identity is never typed anywhere: first and last name come from the name of
# the app token (first-last-COCKPIT-APP) created from Settings.
BW_COLLECTION_NAME=
# Bitwarden server. Defaults to the public Bitwarden cloud; set it for a
# self-hosted or regional server (e.g. https://vault.example.com).
# BW_SERVER_URL=https://vault.bitwarden.com

# ── GitLab ───────────────────────────────────────────────────────────────────
# GitLab API base used for identity lookup and project-token creation.
# GITLAB_API_BASE_URL=https://gitlab.example.com/api/v4

# ── Team data repository (data-tier-0) ───────────────────────────────────────
# GitLab repository holding the team's data, cloned as an encrypted mirror and
# decrypted into data-sub-repositories/ds-data/. Point it at your own repo.
DATA_TIER_0_REPO_URL=https://gitlab.example.com/your-group/mission-deck-data.git
# DATA_TIER_0_DIR=data-sub-repositories/ds-data/
# Parent directory of any additional data source declared in DATA_REPO_DEFS
# (ds-<id>/ + ds-<id>-encrypted/). Defaults to data-sub-repositories/ - in
# practice set only by tests.
# DATA_SUB_REPOS_DIR=data-sub-repositories/

# Background sync of the data repository. Not armed at boot: sync is manual
# (the Sync button in the top bar). Kept for compatibility; leave it at 0.
AUTO_SYNC_ENABLED=0
# Interval in minutes: 10 / 30 / 60
AUTO_SYNC_INTERVAL_MIN=10

# ── Module catalog ───────────────────────────────────────────────────────────
# By default the catalog is the local folder catalog/ (catalog.json plus
# modules/<id>/): install copies from it, publish writes into it, no token is
# needed. MODULES_CATALOG_DIR moves that folder.
# MODULES_CATALOG_DIR=catalog
# Opt-in: a shared catalog hosted on GitLab, read through the REST API (never
# cloned) with COCKPIT_MODULES_TOKEN; publishing then opens a merge request.
# MODULES_CATALOG_REPO_URL=https://gitlab.example.com/your-group/mission-deck-modules.git
# Catalog branch of that repository (default main).
# MODULES_CATALOG_REF=main

# ── Jira / Confluence ────────────────────────────────────────────────────────
# Leave as-is (placeholders) when you do not use Atlassian tools.
JIRA_URL=https://jira.example.com
CONFLUENCE_BASE_URL=https://confluence.example.com
# TLS certificate verification (false when an internal CA is not in the system store)
VERIFY_SSL=true


# ── Academy ──────────────────────────────────────────────────────────────────
# Reset ANOTHER person's training progress (POST /api/cocreate/admin/reset) - a
# facilitator tool, curl only. Off by default; 1 enables it and publishes the change.
# COCREATE_ADMIN_RESET=0


# ── Prototypes: local build and publishing ───────────────────────────────────
# The build shell (Vite + React) lives in data-sub-repositories/data-prototypes/
# and is created on demand: a clone of PROTO_BUILD_REPO_URL when it is set, else
# a copy of the seed in templates/prototype-build-shell/ (local preview only).
# Other shell directory (same pattern as DATA_SUB_REPOS_DIR).
# POC_PAGES_DATA_DIR=
# Git remote prototypes are published to (empty = publishing off).
# PROTO_BUILD_REPO_URL=
# Public address the hosting serves published prototypes under.
# PROTO_PAGES_BASE_URL=
# Optional username paired with the PROTO_DEPLOY_TOKEN vault item (default oauth2).
# PROTO_DEPLOY_TOKEN_USER=oauth2
# Port of the local Vite dev server (default 5173). The preview address is
# http://localhost:<port>/<slug>.
# PROTO_VITE_PORT=5173
# Dry run: publishing goes through clone, ESLint, build and commit and SKIPS
# git push. 1 / true / yes enables it.
# PROTO_DEPLOY_DRY_RUN=0

# ── App usage analytics (opt-in) ─────────────────────────────────────────────
# Off by default. Set an Amplitude browser API key (write-only by design) to
# send app usage events; ANALYTICS_ENABLED=0 switches it off again.
# ANALYTICS_KEY=
# ANALYTICS_ENABLED=1
