{
  "viewport": {
    "width": 1280,
    "height": 800
  },
  "theme": "light",
  "everyShot": [
    {
      "waitMs": 1500
    },
    {
      "clickIfPresent": "#infra-banner .app-update-banner__dismiss"
    },
    {
      "waitMs": 300
    }
