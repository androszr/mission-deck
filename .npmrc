# omit=dev is the default install profile: a fresh clone gets only the
# runtime base (ws, node-pty, node-addon-api), not eslint/husky/lint-staged.
# Contributing code? Run `npm install --include=dev` (or `npm run setup:dev`)
# to add the dev toolchain back; the profile switch is documented in
# README.md and docs/guides/ONBOARDING.md.
#
# `npm ci` inherits `omit` from this file too: every future CI pipeline that
# needs lint/test tooling must call `npm ci --include=dev`, never plain
# `npm ci`.
#
# Never put credentials, tokens or registry auth lines in this file - it is
# committed to the repo.
omit=dev
