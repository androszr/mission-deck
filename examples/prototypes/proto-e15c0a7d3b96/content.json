    {
      "id": "questions",
      "title": "What shift leads asked us",
      "steps": [
        {
          "id": "questions-1",
          "type": "faq",
          "pose": "think",
          "items": [
            {
              "q": "Does the console decide who goes?",
              "a": "No. It ranks the crew; the dispatcher always chooses and can pick anyone."
            },
            {
              "q": "What if a technician has no signal?",
              "a": "The app works offline and sends everything once the phone is back online."
            },
            {
              "q": "Can a safety item be skipped in an emergency?",
              "a": "Not in the app. Emergencies follow the existing rescue procedure, outside the work order."
            },
            {
              "q": "When does this start?",
              "a": "A pilot region first; your shift gets a hands-on session before go-live."
            }
          ],
          "caption": "The four questions we heard most. The short version: **people decide, the tool prepares**, and **safety is never optional**."
        }
      ]
    },
    {
      "id": "summary",
      "title": "What your shift gains",
      "steps": [
        {
          "id": "summary-1",
          "type": "summary",
          "pose": "cheer",
          "items": [
            {
              "icon": "clock",
              "title": "Faster first response",
              "text": "Critical alarms reach the right technician in minutes."
            },
            {
              "icon": "users",
              "title": "Fair, visible workload",
              "text": "Everyone sees whose day is already full."
            },
            {
              "icon": "shield",
              "title": "Safety you can show",
              "text": "Every start of work has its five confirmations on record."
            },
            {
              "icon": "bolt",
              "title": "Less lost production",
              "text": "Turbines are back online sooner - and dispatch knows it immediately."
            }
          ],
          "caption": "That is the whole story: **faster first response**, **visible workload**, **safety on record** and **turbines back online sooner**. Thanks for watching!"
        }
      ]
    }
  ]
