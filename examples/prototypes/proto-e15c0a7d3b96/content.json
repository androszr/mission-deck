  "chapters": [
    {
      "id": "opening",
      "title": "From alarm to repair, faster",
      "steps": [
        {
          "id": "opening-1",
          "type": "card",
          "pose": "wave",
          "caption": "Hi, I am **Vane**. In the next few minutes I will show you how a turbine alarm becomes a finished repair in the **new Ops Console** - and what changes for your shift."
        },
        {
          "id": "opening-2",
          "type": "agenda",
          "pose": "point",
          "caption": "Four stops: **why** we change dispatching, the **new console** for dispatchers, the **technician app** in the field, and the questions shift leads asked us most."
        }
      ]
    },
    {
      "id": "why",
      "title": "Why we change dispatching",
      "steps": [
        {
          "id": "why-1",
          "type": "card",
          "pose": "think",
          "caption": "First, the why. Nobody is doing a bad job today - the **tools make the morning slow**."
        },
        {
          "id": "why-2",
          "type": "why",
          "pose": "think",
          "heading": "Why",
          "paragraphs": [
            {
              "text": "A critical alarm takes on average 40 minutes to reach a technician, most of it spent phoning around for who is free and nearby.",
              "source": "shadowing"
            },
            {
              "text": "Technicians often arrive without the fault history and call back for it from the tower base.",
              "source": "interviews"
            },
            {
              "text": "The safety sign-off is on paper and reaches the office at the end of the day, if at all.",
              "source": "interviews"
            }
          ],
          "benefitsHeading": "What the shift gains",
          "benefits": [
            {
              "icon": "clock",
              "title": "Minutes, not calls",
              "text": "The console suggests who fits the job: skills, distance and free hours in one list.",
              "source": "sessions"
            },
            {
              "icon": "turbine",
              "title": "History in the pocket",
              "text": "Readings, history and the dispatcher's note travel with the job to the phone.",
              "source": "sessions"
            },
            {
              "icon": "shield",
              "title": "Safety on record",
              "text": "Work starts only after the five safety confirmations - logged with the job.",
              "source": "sessions"
            }
          ],
          "caption": "Three things slow the morning down: **finding a free technician**, **missing context** on site, and a **paper safety sign-off**. Each one has a fix in the new console."
        },
        {
          "id": "why-3",
          "type": "compare",
          "pose": "point",
          "before": {
            "title": "Today",
            "points": [
              "Alarm list in one tool, crew calendar in another",
              "Phone calls to find who is free",
              "Fault history requested by phone from site",
              "Paper safety form, collected weekly"
            ]
          },
          "after": {
            "title": "With the new console",
            "points": [
              "Alarms, crew and workload on one screen",
              "Ranked suggestion: best match first",
              "History and note on the technician's phone",
              "Safety check gates the start of work"
            ]
          },
          "caption": "Side by side: what used to need **two tools and three calls** now happens **in one place**."
        }
      ]
    },
